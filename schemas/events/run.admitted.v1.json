{
  "$defs": {
    "Grant": {
      "additionalProperties": false,
      "description": "What a run's worker may reach (spec: Grant).",
      "properties": {
        "network": {
          "$ref": "#/$defs/Network",
          "default": "host"
        },
        "ro": {
          "default": [],
          "description": "Extra paths the worker may read, such as its own runtime.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rw": {
          "default": [],
          "description": "Extra paths the worker may write, besides its workspace.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "substrate": {
          "$ref": "#/$defs/Substrate",
          "default": "bwrap"
        }
      },
      "type": "object"
    },
    "Level": {
      "description": "How a setting is held (spec: Enforcement levels).",
      "enum": [
        "enforced",
        "supported",
        "advisory",
        "unsupported",
        "unrestricted"
      ],
      "type": "string"
    },
    "Network": {
      "oneOf": [
        {
          "const": "host",
          "description": "The host's network, shared: recorded as `unrestricted`.",
          "type": "string"
        },
        {
          "const": "off",
          "description": "An empty network namespace.",
          "type": "string"
        }
      ]
    },
    "Substrate": {
      "oneOf": [
        {
          "const": "bwrap",
          "description": "bubblewrap namespaces with Landlock applied inside.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "No confinement: every grant field is `unsupported`.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`run.admitted`: the configuration the run is bound to (Invariant 5).",
  "properties": {
    "command": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Environment variable name to credential reference; never a value.",
      "type": "object"
    },
    "grant": {
      "$ref": "#/$defs/Grant",
      "default": {
        "network": "host",
        "ro": [],
        "rw": [],
        "substrate": "bwrap"
      },
      "description": "The grant as resolved for this run."
    },
    "levels": {
      "additionalProperties": {
        "$ref": "#/$defs/Level"
      },
      "type": "object"
    },
    "profile": {
      "description": "The profile, as named in the task.",
      "type": "string"
    },
    "profile_digest": {
      "description": "SHA-256 of the profile file, hex.",
      "type": "string"
    },
    "substrate": {
      "type": "string"
    }
  },
  "required": [
    "profile",
    "profile_digest",
    "command",
    "env",
    "substrate",
    "levels"
  ],
  "title": "RunAdmitted",
  "type": "object"
}
