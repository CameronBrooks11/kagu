{
  "$defs": {
    "Grant": {
      "additionalProperties": false,
      "description": "What a run's worker may reach (spec: Grant).",
      "properties": {
        "network": {
          "$ref": "#/$defs/Network",
          "default": "host"
        },
        "ro": {
          "default": [],
          "description": "Extra paths the worker may read, such as its own runtime.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rw": {
          "default": [],
          "description": "Extra paths the worker may write, besides its workspace.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "substrate": {
          "$ref": "#/$defs/Substrate",
          "default": "bwrap"
        }
      },
      "type": "object"
    },
    "Network": {
      "oneOf": [
        {
          "const": "host",
          "description": "The host's network, shared: recorded as `unrestricted`.",
          "type": "string"
        },
        {
          "const": "off",
          "description": "An empty network namespace.",
          "type": "string"
        }
      ]
    },
    "PromptMode": {
      "enum": [
        "append",
        "override"
      ],
      "type": "string"
    },
    "Substrate": {
      "oneOf": [
        {
          "const": "bwrap",
          "description": "bubblewrap namespaces with Landlock applied inside.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "No confinement: every grant field is `unsupported`.",
          "type": "string"
        }
      ]
    },
    "SystemPrompt": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/PromptMode"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "text"
      ],
      "type": "object"
    },
    "Worker": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The worker's argv; it must speak ACP v1 on stdio.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Environment variable name to credential reference (`env:NAME`).",
          "type": "object"
        },
        "home_env": {
          "default": [],
          "description": "Variables set to this profile's harness home, such as\n`CLAUDE_CONFIG_DIR`. With none, the profile has no home.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "home_files": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Files kagu writes at the top of the home before every run, by name,\nand mounts read-only under bwrap: for configuration the harness reads\nfrom its home whatever it is told (spec: Harness home).",
          "type": "object"
        },
        "meta": {
          "additionalProperties": true,
          "default": null,
          "description": "The adapter's `_meta` on `session/new`, passed through unmodified.",
          "type": [
            "object",
            "null"
          ]
        },
        "system_prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/SystemPrompt"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ACP `session/new` `systemPrompt`."
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grant": {
      "$ref": "#/$defs/Grant",
      "default": {
        "network": "host",
        "ro": [],
        "rw": [],
        "substrate": "bwrap"
      }
    },
    "version": {
      "description": "Profile schema version; must be 1.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "worker": {
      "$ref": "#/$defs/Worker"
    }
  },
  "required": [
    "version",
    "worker"
  ],
  "title": "Profile",
  "type": "object"
}
