{
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Params of `task.submit`.",
    "properties": {
      "input": {
        "type": "string"
      },
      "profile": {
        "type": "string"
      },
      "thread": {
        "type": [
          "string",
          "null"
        ]
      },
      "workspace": {
        "type": "string"
      }
    },
    "required": [
      "profile",
      "workspace",
      "input"
    ],
    "title": "Submit",
    "type": "object"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Result of `task.submit`.",
    "properties": {
      "run": {
        "type": "string"
      }
    },
    "required": [
      "run"
    ],
    "title": "Submitted",
    "type": "object"
  }
}
